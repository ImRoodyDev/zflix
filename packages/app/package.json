{
	"name": "app",
	"license": "CC-BY-NC-4.0",
	"version": "1.0.0",
	"private": true,
	"main": "expo-router/entry",
	"expo": {
		"install": {
			"exclude": [
				"react-native"
			]
		}
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint": "expo lint",
		"lint:fix": "expo lint --fix",
		"prebuild": "expo prebuild --clean",
		"start": "expo start --clear -d",
		"start:web": "expo start -w --clear",
		"android": "expo run:android",
		"android:device": "expo run:android --device",
		"android:build-apk": "android/gradlew.bat -p android assembleRelease",
		"ios": "expo run:ios",
		"web": "expo start --web",
		"export:web": "expo export --platform web",
		"eas:build:android": "eas build -p android",
		"eas:build:ios": "eas build -p ios",
		"deploy": "npx expo export -p web && wrangler deploy",
		"preview": "npx expo export -p web && wrangler dev"
	},
	"dependencies": {
		"@expo/vector-icons": "^14.1.0",
		"@imroodydev/legendapp-list": "3.0.6-tv-optimized.alpha.1",
		"@imroodydev/rn-intersection-observer": "1.0.0-alpha.0",
		"@react-native-async-storage/async-storage": "2.1.2",
		"@react-navigation/native": "^7.1.6",
		"base-64": "^1.0.0",
		"clsx": "^2.1.1",
		"expo": "53.0.27",
		"expo-application": "~6.1.5",
		"expo-blur": "~14.1.5",
		"expo-build-properties": "~0.14.8",
		"expo-constants": "~17.1.7",
		"expo-device": "~7.1.4",
		"expo-font": "~13.3.2",
		"expo-haptics": "~14.1.4",
		"expo-image": "~2.4.1",
		"expo-linear-gradient": "~14.1.5",
		"expo-linking": "~7.1.7",
		"expo-router": "~5.1.10",
		"expo-secure-store": "~14.2.4",
		"expo-splash-screen": "~0.30.10",
		"expo-status-bar": "~2.2.3",
		"expo-system-ui": "~5.0.11",
		"expo-web-browser": "~14.2.0",
		"i18next": "^25.6.0",
		"iconsax-react-native": "^0.0.8",

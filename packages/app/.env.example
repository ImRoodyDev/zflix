# App environment: use "development" or "production"
EXPO_PUBLIC_APP_NAME=ZFlix
EXPO_PUBLIC_APP_ENV=production

# Public contact email shown in the app
EXPO_PUBLIC_APP_EMAIL=hello@example.com

# Public backend API base URL. Use your Render web service URL.
EXPO_PUBLIC_API_URL=https://zflix-api.onrender.com

# Public download links shown by the app
EXPO_PUBLIC_ANDROID_DOWNLOAD_URL=https://example.com/android
EXPO_PUBLIC_IOS_DOWNLOAD_URL=https://example.com/ios
EXPO_PUBLIC_WINDOWS_DOWNLOAD_URL=https://example.com/windows

# Public client-side keys. Anything EXPO_PUBLIC_* is visible in web/native bundles.
EXPO_PUBLIC_TMDB_API_KEYS=tmdb_key_1,tmdb_key_2

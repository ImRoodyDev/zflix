# Server runtime
ENV=production
APP_NAME=ZFlix
APP_LOGO_URL=https://example.com/logo.png
SERVER_DOMAIN=https://zflix-api.onrender.com
FRONTEND_DOMAINS=https://your-github-username.github.io,https://your-github-username.github.io/zflix
WEBHOOK_ORIGINS=https://api-m.paypal.com,https://api.paypal.com,https://www.paypal.com
NOREPLY_EMAIL=no-reply@example.com

# Cookie configuration
# When the API and frontend are on different domains (cross-domain), set:
#   COOKIE_SAME_SITE=none
#   COOKIE_SECURE=true   (browsers require Secure when SameSite=None)
#   COOKIE_PARTITIONED=true   (needed when browsers block third-party cookies)
# For local development where both run on localhost, use:
#   COOKIE_SAME_SITE=lax
#   COOKIE_SECURE=false
#   COOKIE_PARTITIONED=false
COOKIE_SAME_SITE=none
COOKIE_SECURE=true
COOKIE_PARTITIONED=true

# Admin bootstrap
ADMIN_ID=admin
ADMIN_HASH=replace-with-a-bcrypt-hash

# Sequelize database. Current codebase is configured for MySQL/mysql2.
SEQUELIZE_DB=zflix
SEQUELIZE_USER=avnadmin
SEQUELIZE_PASS=replace-me
SEQUELIZE_HOST=mysql-provider-host.example.com
SEQUELIZE_DIALECT=mysql
SEQUELIZE_PORT=3306
SEQUELIZE_LOGGING=false

# Redis-compatible cache
REDIS_MODE=external
REDIS_LOCAL_HOST=127.0.0.1
REDIS_LOCAL_PORT=6379
REDIS_EXTERNAL_URL=rediss://default:replace-me@provider-host.example.com:6379

# TMDB
TMDB_ACCESS_TOKEN=replace-me

# IPINFO API KEY @see https://ipinfo.io/
IPINFO_TOKEN='replace-me'  

# Payments
PAYPAL_CLIENT_ID=replace-me
PAYPAL_APP_SECRET=replace-me
PAYPAL_WEBHOOK_ID=replace-me
PAYPAL_HOOK_PORT=443
STRIPE_SECRET_KEY=replace-me
STRIPE_WEBHOOK_SECRET=replace-me

# Mailer
MAILER_HOST=smtp.example.com
MAILER_PORT=465
MAILER_EMAIL=no-reply@example.com
MAILER_PASS=replace-me
MAILER_SECURE=true

# JWT/session config. In production, this code expects the *_TOKEN_* and ACCESS_CODE_* names.
SESSION_SECRET_KEY=replace-with-long-random-string
ACCESS_TOKEN_EXPIRY=15m
ACCESS_CODE_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
ACCESS_CODE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
REFRESH_TOKEN_EXPIRY=30d
# How often an active session re-issues its refresh token (ms format). Must be << REFRESH_TOKEN_EXPIRY.
REFRESH_SLIDE_INTERVAL=1d
REFRESH_TOKEN_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
REFRESH_TOKEN_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
RESET_TOKEN_EXPIRY=15m
RESET_TOKEN_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
RESET_TOKEN_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
